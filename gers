                    Master
                </div>
            </div>

            <div class="points">
                11 970
            </div>

        </div>

    </div>

</section>

</main>


<script>

function openPage(page, button) {

    document
        .querySelectorAll(".page")
        .forEach(
            p => p.classList.remove("active")
        );

    document
        .getElementById(page)
        .classList.add("active");


    document
        .querySelectorAll("nav button")
        .forEach(
            b => b.classList.remove("active")
        );

    if (button) {
        button.classList.add("active");
    }

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });
}

</script>

</body>
</html>
