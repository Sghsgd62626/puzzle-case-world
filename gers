            </div>


            <div class="card">

                <div class="visual">
                    👑
                </div>

                <h3>
                    Golden Champion
                </h3>

                <span class="muted">
                    Special
                </span>

            </div>


            <div class="card">

                <div class="visual">
                    🤖
                </div>

                <h3>
                    Cyber Bot
                </h3>

                <span class="muted">
                    Epic
                </span>

            </div>

        </div>

    </div>


    <div class="section">

        <div class="title">
            <h2>
                Статистика
            </h2>
        </div>

        <div class="stats">

            <div class="stat">
                <span class="muted">
                    Игроков
                </span>

                <strong>
                    24 891
                </strong>
            </div>

            <div class="stat">
                <span class="muted">
                    Скинов
                </span>

                <strong>
                    1 284
                </strong>
            </div>

            <div class="stat">
                <span class="muted">
                    Матчей
                </span>

                <strong>
                    98 420
                </strong>
            </div>

            <div class="stat">
                <span class="muted">
                    Онлайн
                </span>

                <strong>
                    1 247
                </strong>
            </div>

        </div>

    </div>

</section>


<!-- СКИНЫ -->

<section
    id="skins"
    class="page">

    <div class="title">

        <h2>
            Скины
        </h2>

        <span>
