<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>StumbleHub</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background: #090b10;
    color: white;
    font-family: Arial, sans-serif;
}

/* HEADER */

header {
    height: 72px;
    background: #0d1017;
    border-bottom: 1px solid #252a35;

    display: flex;
    align-items: center;
    padding: 0 5%;
    gap: 35px;

    position: sticky;
    top: 0;
    z-index: 10;
}

.logo {
    font-size: 23px;
    font-weight: 900;
}

.logo span {
    color: #7657ff;
}

nav {
    display: flex;
    gap: 5px;
}

nav button {
    border: none;
    background: transparent;
    color: #858c9e;

    padding: 11px 16px;
    border-radius: 9px;

    cursor: pointer;
    font-weight: bold;
}

nav button:hover,
nav button.active {
    background: #191d26;
    color: white;
}

.profile {
    margin-left: auto;

    padding: 10px 15px;
    border-radius: 10px;

    background: #171b24;
    border: 1px solid #292e3a;

    font-weight: bold;
}

/* MAIN */

main {
    max-width: 1250px;
    margin: auto;
    padding: 32px 5% 70px;
}

.page {
    display: none;
}

.page.active {
    display: block;
}

/* HERO */

.hero {
    min-height: 400px;

    border: 1px solid #292e3a;
    border-radius: 24px;

    padding: 55px;

    display: flex;
    align-items: center;

    overflow: hidden;
    position: relative;

    background:
        radial-gradient(
            circle at 85% 50%,
            #6845b8 0%,
            #292450 25%,
            #11151e 65%
        );
}

.hero:after {
    content: "";

    position: absolute;

    width: 430px;
    height: 430px;

    right: -100px;
    top: -70px;

    border-radius: 50%;

    background: linear-gradient(
        135deg,
        #875cff,
        #3d8cff
    );

    opacity: .22;
}

.hero-content {
    position: relative;
    z-index: 2;

    max-width: 600px;
}

.badge {
    display: inline-block;

    padding: 7px 12px;

    border-radius: 7px;

    background: #241d42;
    border: 1px solid #55458b;

    color: #b7a7ff;

    font-size: 12px;
    font-weight: bold;
}

h1 {
    font-size: clamp(45px, 7vw, 75px);
    line-height: .9;

    margin: 18px 0;

    letter-spacing: -4px;
}

.hero p {
    color: #aeb4c4;

    max-width: 500px;

    line-height: 1.6;

    margin-bottom: 22px;
}

.primary {
    border: none;

    padding: 14px 22px;

    border-radius: 10px;

    color: white;

    font-weight: bold;

    background: linear-gradient(
        135deg,
        #7656ff,
        #9b4dff
    );

    cursor: pointer;
}

/* SECTIONS */

.section {
    margin-top: 40px;
}

.title {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 18px;
}

.title h2 {
    font-size: 24px;
}

.title span {
    color: #747b8e;
    font-size: 13px;
}

/* CARDS */

.cards {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 16px;
}

.card {
    height: 280px;

    padding: 18px;

    border-radius: 17px;

    background:
        linear-gradient(
            145deg,
            #171a23,
            #0e1118
        );

    border: 1px solid #252a36;

    overflow: hidden;
}

.visual {
    height: 195px;

    border-radius: 13px;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 80px;

    background:
        radial-gradient(
            circle,
            #3b4160,
            #171a24 65%
        );
}

.card h3 {
    margin-top: 13px;
    margin-bottom: 4px;
}

.muted {
    color: #747b8e;
    font-size: 13px;
}

/* STATS */

.stats {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 12px;
}

.stat {
    padding: 20px;

    border-radius: 14px;

    background: #11141c;

    border: 1px solid #242936;
}

.stat strong {
    display: block;

    font-size: 27px;

    margin-top: 7px;
}

/* LEADERBOARD */

.list {
    display: grid;
    gap: 10px;
}

.player {
    display: flex;

    align-items: center;

    gap: 15px;

    padding: 15px;

    background: #11141c;

    border: 1px solid #242936;

    border-radius: 13px;
}

.number {
    width: 35px;

    color: #777f92;

    font-weight: 900;
}

.avatar {
    width: 42px;
    height: 42px;

    border-radius: 10px;

    display: flex;
    align-items: center;
    justify-content: center;

    background:
        linear-gradient(
            135deg,
            #7054ff,
            #3e8cff
        );

    font-weight: 900;
}

.player-name {
    font-weight: bold;
}

.player-rank {
    color: #737b8d;
    font-size: 12px;
    margin-top: 3px;
}

.points {
    margin-left: auto;
    font-weight: bold;
}

/* MOBILE */

@media(max-width:800px) {

    header {
        padding: 0 15px;
        gap: 10px;
    }

    .logo {
        font-size: 18px;
    }

    nav button {
        padding: 9px 7px;
        font-size: 11px;
    }

    .profile {
        display: none;
    }

    main {
        padding: 20px 15px;
    }

    .hero {
        padding: 30px;
    }

    .cards {
        grid-template-columns: 1fr;
    }

    .stats {
        grid-template-columns:
            repeat(2, 1fr);
    }
}
</style>
</head>

<body>

<header>

    <div class="logo">
        STUMBLE<span>HUB</span>
    </div>

    <nav>

        <button
            class="active"
            onclick="openPage('home', this)">
