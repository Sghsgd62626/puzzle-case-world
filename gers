            <span class="muted">Rare</span>
        </div>

        <div class="card">
            <div class="visual">⚡</div>
            <h3>Volt</h3>
            <span class="muted">Epic</span>
        </div>

        <div class="card">
            <div class="visual">🧊</div>
            <h3>Ice King</h3>
            <span class="muted">Legendary</span>
        </div>

    </div>

</section>


<!-- ИНВЕНТАРЬ -->

<section
    id="inventory"
    class="page">

    <div class="title">

        <h2>
            Инвентарь
        </h2>

        <span>
            YT|Ares vega
        </span>

    </div>


    <div class="cards">

        <div class="card">
            <div class="visual">👑</div>
            <h3>Golden Champion</h3>
