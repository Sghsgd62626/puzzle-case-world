                12 840
            </div>

        </div>


        <div class="player">

            <div class="number">
                02
            </div>

            <div class="avatar">
                S
            </div>

            <div>
                <div class="player-name">
                    Shadow
                </div>

                <div class="player-rank">
                    Champion
                </div>
            </div>

            <div class="points">
                12 510
            </div>

        </div>


        <div class="player">

            <div class="number">
                03
            </div>

            <div class="avatar">
                V
            </div>

            <div>
