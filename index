<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>StumbleHub</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    background: #080a0f;
    color: white;
}

/* HEADER */

header {
    height: 72px;
    background: #0d1017;
    border-bottom: 1px solid #202532;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 35px;

    position: sticky;
    top: 0;
    z-index: 100;
}

.logo {
    font-size: 24px;
    font-weight: 900;
    letter-spacing: 1px;
}

.logo span {
    color: #7656ff;
}

nav {
    display: flex;
    gap: 8px;
}

nav button {
    border: 0;
    background: transparent;
    color: #8d94a5;

    padding: 12px 18px;

    border-radius: 10px;

    cursor: pointer;
    font-size: 14px;
}

nav button:hover,
nav button.active {
    background: #171b26;
    color: white;
}

.profile {
    display: flex;
    align-items: center;
    gap: 10px;

    background: #141821;
    padding: 8px 12px;

    border-radius: 12px;
}

.profile-avatar {
    width: 35px;
    height: 35px;

    border-radius: 50%;

    object-fit: cover;
    background: #252b38;
}

.profile-name {
    font-size: 13px;
    font-weight: bold;
}

/* MAIN */

main {
    max-width: 1400px;
    margin: auto;
    padding: 35px;
}

.hero {
    min-height: 280px;

    border-radius: 22px;

    background:
        radial-gradient(circle at 80% 20%, #704bff44, transparent 35%),
        linear-gradient(135deg, #151925, #0d1017);

    border: 1px solid #252a38;

    padding: 45px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    overflow: hidden;
}

.hero-text {
    max-width: 600px;
}

.hero h1 {
    font-size: 46px;
    margin-bottom: 15px;
}

.hero h1 span {
    color: #7656ff;
}

.hero p {
    color: #9299aa;
    line-height: 1.6;
}

.hero-button {
    margin-top: 25px;

    background: #7656ff;
    color: white;

    border: none;
    border-radius: 12px;

    padding: 14px 24px;

    font-weight: bold;
    cursor: pointer;
}

.hero-button:hover {
    background: #896cff;
}

/* SECTION */

.section {
    margin-top: 35px;
}

.section-title {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 18px;
}

.section-title h2 {
    font-size: 24px;
}

.section-title span {
    color: #737b8e;
    font-size: 13px;
}

/* CONTROLS */

.controls {
    display: flex;
    gap: 12px;

    margin-bottom: 22px;
}

.search {
    flex: 1;

    background: #10131b;
    border: 1px solid #252a38;

    color: white;

    padding: 14px 16px;

    border-radius: 12px;

    outline: none;
}

.search:focus {
    border-color: #7656ff;
}

.filter {
    background: #10131b;
    color: white;

    border: 1px solid #252a38;

    padding: 0 18px;

    border-radius: 12px;

    outline: none;
}

/* SKINS */

.skin-grid {
    display: grid;

    grid-template-columns:
        repeat(auto-fill, minmax(190px, 1fr));

    gap: 18px;
}

.skin-card {
    background: #10131b;

    border: 1px solid #242936;

    border-radius: 18px;

    overflow: hidden;

    cursor: pointer;

    transition: .2s;
}

.skin-card:hover {
    transform: translateY(-5px);

    border-color: #7656ff;

    box-shadow:
        0 12px 35px #00000055;
}

.skin-image {
    height: 240px;

    background:
        radial-gradient(circle at center, #292e40, #11141c);

    display: flex;
    align-items: flex-end;
    justify-content: center;

    overflow: hidden;
}

.skin-image img {
    width: 100%;
    height: 100%;

    object-fit: contain;

    transition: .25s;
}

.skin-card:hover .skin-image img {
    transform: scale(1.05);
}

.skin-info {
    padding: 15px;
}

.skin-name {
    font-size: 16px;
    font-weight: bold;
}

.rarity {
    display: inline-block;

    margin-top: 8px;

    padding: 5px 9px;

    border-radius: 7px;

    font-size: 11px;
    font-weight: bold;

    background: #252a38;
    color: #aaa;
}

.rarity.special {
    color: #c4a5ff;
    background: #7656ff22;
}

.rarity.legendary {
    color: #ffca58;
    background: #ffca5822;
}

/* EMPTY */

.empty {
    display: none;

    text-align: center;

    padding: 50px;

    color: #777f91;
}

/* MODAL */

.modal {
    position: fixed;

    inset: 0;

    background: #000000aa;

    display: none;

    align-items: center;
    justify-content: center;

    z-index: 200;

    padding: 20px;
}

.modal.show {
    display: flex;
}

.modal-box {
    width: 440px;
    max-width: 100%;

    background: #11141c;

    border: 1px solid #2a3040;

    border-radius: 22px;

    padding: 25px;

    position: relative;
}

.close {
    position: absolute;

    right: 18px;
    top: 15px;

    border: none;
    background: #202532;

    color: white;

    width: 35px;
    height: 35px;

    border-radius: 50%;

    cursor: pointer;
}

.modal-image {
    height: 350px;

    border-radius: 15px;

    background:
        radial-gradient(circle, #30364a, #11141c);

    display: flex;
    justify-content: center;
    align-items: center;

    overflow: hidden;

    margin-bottom: 20px;
}

.modal-image img {
    width: 100%;
    height: 100%;

    object-fit: contain;
}

.modal h2 {
    font-size: 25px;
}

.modal p {
    margin-top: 8px;
    color: #81899b;
}

.modal-button {
    width: 100%;

    margin-top: 20px;

    padding: 14px;

    border: none;

    border-radius: 11px;

    background: #7656ff;

    color: white;

    font-weight: bold;

    cursor: pointer;
}

/* RESPONSIVE */

@media(max-width: 800px) {

    header {
        padding: 0 15px;
    }

    nav {
        display: none;
    }

    main {
        padding: 18px;
    }

    .hero {
        padding: 28px;

        min-height: 250px;
    }

    .hero h1 {
        font-size: 34px;
    }

    .controls {
        flex-direction: column;
    }

    .filter {
        height: 48px;
    }

    .skin-grid {
        grid-template-columns:
            repeat(2, 1fr);
    }

    .skin-image {
        height: 210px;
    }
}
</style>
</head>

<body>

<header>

    <div class="logo">
        STUMBLE<span>HUB</span>
    </div>

    <nav>
        <button class="active">Главная</button>
        <button>Скины</button>
        <button>Инвентарь</button>
        <button>Лидеры</button>
    </nav>

    <div class="profile">
        <img
            class="profile-avatar"
            src="images/profile.png"
            onerror="this.style.display='none'"
        >

        <div class="profile-name">
            YT|Ares vega
        </div>
    </div>

</header>


<main>

    <section class="hero">

        <div class="hero-text">

            <h1>
                STUMBLE<span>HUB</span>
            </h1>

            <p>
                Твоя коллекция Stumblers.
                Смотри скины, собирай коллекцию
                и следи за редкими персонажами.
            </p>

            <button class="hero-button"
                    onclick="scrollToSkins()">
                Смотреть скины
            </button>

        </div>

    </section>


    <section class="section" id="skins">

        <div class="section-title">

            <h2>Популярные Stumblers</h2>

            <span id="count">
                6 персонажей
            </span>

        </div>


        <div class="controls">

            <input
                id="search"
                class="search"
                placeholder="Поиск Stumbler..."
                oninput="filterSkins()"
            >

            <select
                id="rarity"
                class="filter"
                onchange="filterSkins()"
            >

                <option value="all">
                    Все редкости
                </option>

                <option value="special">
                    Special
                </option>

                <option value="legendary">
                    Legendary
                </option>

            </select>

        </div>


        <div class="skin-grid" id="skinGrid">


            <!-- SKIN 1 -->

            <div
                class="skin-card"
                data-name="capt goldheart"
                data-rarity="special"
                onclick="openSkin(
                    'Capt. Goldheart',
                    'Special',
                    'images/stumbler1.png'
                )"
            >

                <div class="skin-image">

                    <img
                        src="images/stumbler1.png"
                        alt="Capt. Goldheart"
                    >

                </div>

                <div class="skin-info">

                    <div class="skin-name">
                        Capt. Goldheart
                    </div>

                    <span class="rarity special">
                        SPECIAL
                    </span>

                </div>

            </div>


            <!-- SKIN 2 -->

            <div
                class="skin-card"
                data-name="inferno dragon"
                data-rarity="special"
                onclick="openSkin(
                    'Inferno Dragon',
                    'Special',
                    'images/stumbler2.png'
                )"
            >

                <div class="skin-image">

                    <img
                        src="images/stumbler2.png"
                        alt="Inferno Dragon"
                    >

                </div>

                <div class="skin-info">

                    <div class="skin-name">
                        Inferno Dragon
                    </div>

                    <span class="rarity special">
                        SPECIAL
                    </span>

                </div>

            </div>


            <!-- SKIN 3 -->

            <div
                class="skin-card"
                data-name="dynamitron"
                data-rarity="special"
                onclick="openSkin(
                    'Dynamitron',
                    'Special',
                    'images/stumbler3.png'
                )"
            >

                <div class="skin-image">

                    <img
                        src="images/stumbler3.png"
                        alt="Dynamitron"
                    >

                </div>

                <div class="skin-info">

                    <div class="skin-name">
                        Dynamitron
                    </div>

                    <span class="rarity special">
                        SPECIAL
                    </span>

                </div>

            </div>


            <!-- SKIN 4 -->

            <div
                class="skin-card"
                data-name="red demon"
                data-rarity="legendary"
                onclick="openSkin(
                    'Red Demon',
                    'Legendary',
                    'images/stumbler4.png'
                )"
            >

                <div class="skin-image">

                    <img
                        src="images/stumbler4.png"
                        alt="Red Demon"
                    >

                </div>

                <div class="skin-info">

                    <div class="skin-name">
                        Red Demon
                    </div>

                    <span class="rarity legendary">
                        LEGENDARY
                    </span>

                </div>

            </div>


            <!-- SKIN 5 -->

            <div
                class="skin-card"
                data-name="stumble king"
                data-rarity="legendary"
                onclick="openSkin(
                    'Stumble King',
                    'Legendary',
                    'images/stumbler5.png'
                )"
            >

                <div class="skin-image">

                    <img
                        src="images/stumbler5.png"
                        alt="Stumble King"
                    >

                </div>

                <div class="skin-info">

                    <div class="skin-name">
                        Stumble King
                    </div>

                    <span class="rarity legendary">
                        LEGENDARY
                    </span>

                </div>

            </div>


            <!-- SKIN 6 -->

            <div
                class="skin-card"
                data-name="leonidas"
                data-rarity="legendary"
                onclick="openSkin(
                    'Leonidas',
                    'Legendary',
                    'images/stumbler6.png'
                )"
            >

                <div class="skin-image">

                    <img
                        src="images/stumbler6.png"
                        alt="Leonidas"
                    >

                </div>

                <div class="skin-info">

                    <div class="skin-name">
                        Leonidas
                    </div>

                    <span class="rarity legendary">
                        LEGENDARY
                    </span>

                </div>

            </div>


        </div>


        <div class="empty" id="empty">
            Ничего не найдено
        </div>

    </section>

</main>


<!-- MODAL -->

<div
    class="modal"
    id="modal"
    onclick="closeOutside(event)"
>

    <div class="modal-box">

        <button
            class="close"
            onclick="closeSkin()"
        >
            ×
        </button>

        <div class="modal-image">

            <img
                id="modalImage"
                src=""
                alt=""
            >

        </div>

        <h2 id="modalName">
            Stumbler
        </h2>

        <p id="modalRarity">
            Special
        </p>

        <button
            class="modal-button"
            onclick="closeSkin()"
        >
            Закрыть
        </button>

    </div>

</div>


<script>

function openSkin(name, rarity, image) {

    document.getElementById("modalName")
        .textContent = name;

    document.getElementById("modalRarity")
        .textContent = rarity;

    document.getElementById("modalImage")
        .src = image;

    document.getElementById("modal")
        .classList.add("show");
}


function closeSkin() {

    document.getElementById("modal")
        .classList.remove("show");

}


function closeOutside(event) {

    if (event.target.id === "modal") {
        closeSkin();
    }

}


function scrollToSkins() {

    document.getElementById("skins")
        .scrollIntoView({
            behavior: "smooth"
        });

}


function filterSkins() {

    const search =
        document.getElementById("search")
            .value
            .toLowerCase();

    const rarity =
        document.getElementById("rarity")
            .value;

    const cards =
        document.querySelectorAll(".skin-card");

    let visible = 0;


    cards.forEach(card => {

        const name =
            card.dataset.name;

        const cardRarity =
            card.dataset.rarity;


        const matchesSearch =
            name.includes(search);

        const matchesRarity =
            rarity === "all" ||
            cardRarity === rarity;


        if (
            matchesSearch &&
            matchesRarity
        ) {

            card.style.display = "";

            visible++;

        } else {

            card.style.display = "none";

        }

    });


    document.getElementById("count")
        .textContent =
        visible + " персонажей";


    document.getElementById("empty")
        .style.display =
        visible === 0
            ? "block"
            : "none";

}

</script>

</body>
</html>
