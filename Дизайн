<script>

function page(id,button){

document
.querySelectorAll(".page")
.forEach(
p=>p.classList.remove("active")
);

document
.getElementById(id)
.classList.add("active");

document
.querySelectorAll("nav button")
.forEach(
b=>b.classList.remove("active")
);

if(button){
button.classList.add("active");
}

window.scrollTo({
top:0,
behavior:"smooth"
});

}


function openSkin(name,icon,rarity){

document
.getElementById("modal")
.classList.add("show");

document
.getElementById("modalName")
.textContent=name;

document
.getElementById("modalRarity")
.textContent=rarity;

document
.getElementById("modalVisual")
textContent=icon;

}


function closeSkin(){

document
.getElementById("modal")
.classList.remove("show");

}


function searchSkins(){

const search=
document
.getElementById("search")
.value
.toLowerCase();

const rarity=
document
.getElementById("rarity")
.value;


document
.querySelectorAll(".skin-item")
.forEach(card=>{

const name=
card.dataset.name
.toLowerCase();

const cardRarity=
card.dataset.rarity;

const nameOK=
name.includes(search);

const rarityOK=
rarity==="all" ||
cardRarity===rarity;

if(nameOK && rarityOK){

card.style.display="block";

}else{

card.style.display="none";

}

});

}

</script>

